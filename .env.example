# Upstash Redis (Vercel KV works too)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Vercel KV variables (used as fallback names)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Security
# Set to true to require EIP-191 signatures on all POST endpoints
RELAY_REQUIRE_SIGNATURE=false

# Explorers on-chain usados no grafo de interações de /api/stats (opcional)
# Com uma chave do Etherscan v2, todas as chains EVM são cobertas via
# https://api.etherscan.io/v2/api?chainid=<id>. Sem chave, o relay usa
# instâncias públicas do Blockscout (ETH, Optimism, Gnosis, Polygon, Base,
# Arbitrum, Sepolia). Bitcoin (mempool.space), Stellar (Horizon) e Solana
# (RPC público) não precisam de chave.
ETHERSCAN_API_KEY=

# CORS (comma-separated; use * for any origin)
ALLOWED_ORIGINS=*

# URL pública da página /install no relay (gerada por build-android-apk.ts)
RELAY_INSTALL_URL=https://rapport-crypto-p2p-chat-relay.vercel.app/install
