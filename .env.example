# Upstash Redis (Vercel KV works too)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Vercel KV variables (used as fallback names)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Security
# Set to true to require EIP-191 signatures on all POST endpoints
RELAY_REQUIRE_SIGNATURE=false

# CORS (comma-separated; use * for any origin)
ALLOWED_ORIGINS=*

# URL pública da página /install no relay (gerada por build-android-apk.ts)
RELAY_INSTALL_URL=https://rapport-crypto-p2p-chat-relay.vercel.app/install

# === Circle Onramp Kit (App Kit) ===
# API key from https://console.circle.com/api-keys/kit-keys — server-side only.
CIRCLE_ONRAMP_API_KEY=
# Optional: sandbox widget origin (default https://onramp.arc.io)
# CIRCLE_ONRAMP_WIDGET_BASE_URL=https://onramp-sandbox.arc.io
# Optional: bare hostname authorized as iframe ancestor (no scheme/port/path).
# CIRCLE_ONRAMP_REFERRER_DOMAIN=

# === Ban DAO (espelho para /api/ban, /ban e enforcement) ===
# Endereço da BanQuadraticDAO na Polygon; sem ele a banlist fica inativa.
BAN_DAO_ADDRESS=0x720EA8Ce185FEEE8e056a0461a0ED0c56973815a
# RPC da Polygon para leituras isBanned/listProposals (default https://polygon-rpc.com)
POLYGON_RPC_URL=https://polygon.drpc.org
# Carteira admin autorizada a assinar POST /api/ban (default = suporte oficial)
BAN_ADMIN_WALLET=0x7010A4C4c189AB421028a622e2A2e623f432d18e
