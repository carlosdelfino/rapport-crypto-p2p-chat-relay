# Upstash Redis (Vercel KV works too)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Vercel KV variables (used as fallback names)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Security
# Set to true to require EIP-191 signatures on all POST endpoints
RELAY_REQUIRE_SIGNATURE=false

# CORS (comma-separated; use * for any origin)
ALLOWED_ORIGINS=*

# URL pública da página /install no relay (gerada por build-android-apk.ts)
RELAY_INSTALL_URL=https://rapport-crypto-p2p-chat-relay.vercel.app/install
